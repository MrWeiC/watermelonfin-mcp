{
  "name": "watermelonfin-mcp",
  "version": "0.1.3",
  "description": "Local agent MCP for safe Jellyfin discovery, read-only management and additive media imports",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "watermelonfin-mcp": "src/cli.js",
    "watermelonfin-importer": "src/importer-cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/*.test.js",
    "check": "node --test tests/*.test.js",
    "importer": "node src/importer-cli.js",
    "test:plugin": "./scripts/validate-plugin.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "files": [
    "src",
    "assets",
    "recipes",
    "README.md",
    "docs",
    "SECURITY.md",
    "examples",
    "tests",
    "plugin/WatermelonFin.Plugin",
    "scripts",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "Wei Chen (@MrWeiC)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWeiC/watermelonfin-mcp.git"
  },
  "homepage": "https://github.com/MrWeiC/watermelonfin-mcp",
  "bugs": {
    "url": "https://github.com/MrWeiC/watermelonfin-mcp/issues"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
